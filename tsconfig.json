{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun", "node"]
  },
  "include": ["core/**/*.ts", "adapters/telegram/**/*.ts", "bin/*.ts", "test/**/*.ts", "desktop/*.ts"]
}
